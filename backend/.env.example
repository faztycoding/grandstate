# ============================================
# Grand$tate Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server
PORT=3001
FRONTEND_URL=http://localhost:8080

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key  # fallback if SERVICE_KEY not set

# Admin access — comma-separated email addresses
# These emails can access /api/admin/* endpoints (force-stop, stats, license management)
ADMIN_EMAILS=admin@example.com,admin2@example.com

# Anthropic / Claude API (optional — for caption generation)
# ANTHROPIC_API_KEY=sk-ant-...

# Browser automation
# HEADLESS=true          # Set to 'true' for VPS/headless mode (Chrome invisible)
# DISPLAY=:1             # VNC display number — auto-detected if not set (default :1)
# PROXY_URL=             # Optional proxy for Puppeteer
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable  # VPS only

# Queue system
# MAX_CONCURRENT_AUTOMATIONS=3  # Default: 3
