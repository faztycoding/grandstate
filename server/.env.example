# Payment Server Configuration
# Copy this file to .env and set real values before running server/payment.js

# Server
PORT=3002
FRONTEND_URL=http://localhost:8080
NODE_ENV=development

# Omise
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Supabase (service role key required for issuing licenses)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional email delivery (license email)
EMAIL_USER=
EMAIL_PASS=
