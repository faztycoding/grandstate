# ===========================================
# FRONTEND - Vite Environment Variables
# ===========================================

# Omise Public Key (safe to expose in frontend)
VITE_OMISE_PUBLIC_KEY=pkey_test_xxxxx

# Supabase (safe to expose - uses RLS for security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL
VITE_API_BASE=https://api.grandstate.io

# Admin emails (comma-separated)
VITE_ADMIN_EMAILS=admin@example.com

# Admin secret URL token (ใช้เข้า /admin/TOKEN)
VITE_ADMIN_SECRET=change-this-to-a-random-string

# ===========================================
# BACKEND - Server Environment Variables
# (Create backend/.env file for these)
# ===========================================

# Omise Secret Key (NEVER expose in frontend!)
# OMISE_SECRET_KEY=skey_test_xxxxx

# Supabase Service Key (for server-side operations)
# SUPABASE_SERVICE_KEY=your-service-key-here

# Claude API Key (for AI caption generation)
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Frontend URL for redirects
# FRONTEND_URL=http://localhost:8080

# Admin emails for backend /api/admin/* authorization (comma-separated)
# Must match VITE_ADMIN_EMAILS above
# ADMIN_EMAILS=admin@example.com
